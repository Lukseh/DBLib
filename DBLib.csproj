<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>CounterStrikeSharpDBLib</PackageId>
    <Version>0.0.1</Version>
    <Authors>Lukseh</Authors>
    <Description>API for sharing database connections between CounterStrikeSharp plugins.</Description>
    <RepositoryUrl>https://github.com/Lukseh/DBLib</RepositoryUrl>
    <PackageTags>CounterStrikeSharp;Database;DBLib</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
    <PackageReference Include="linq2db" Version="6.5.1" />
    <PackageReference Include="linq2db.PostgreSQL" Version="6.5.1" />
  </ItemGroup>

</Project>
